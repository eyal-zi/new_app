    "/api/sessions/group": {
      "post": {
        "operationId": "groupSessions",
        "parameters": [
          {
            "name": "first_session_index",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "number_of_sessions",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupSessionsBodyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/InferenceSessionDto"
                      },
                      {
                        "$ref": "#/components/schemas/TrainingSessionDto"
                      },
                      {
                        "$ref": "#/components/schemas/EvaluationSessionDto"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "type",
                      "mapping": {
                        "inference": "#/components/schemas/InferenceSessionDto",
                        "training": "#/components/schemas/TrainingSessionDto",
                        "evaluation": "#/components/schemas/EvaluationSessionDto"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a group of sessions of any type",
        "tags": [
          "sessions"
        ],
        "x-query": true
      }
    },
    "/api/{type}/sessions/group": {
      "post": {
        "operationId": "groupSessionsByType",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionType"
            }
          },
          {
            "name": "first_session_index",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "number_of_sessions",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 10,
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupSessionsBodyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/InferenceSessionDto"
                      },
                      {
                        "$ref": "#/components/schemas/TrainingSessionDto"
                      },
                      {
                        "$ref": "#/components/schemas/EvaluationSessionDto"
                      }
                    ],
                    "discriminator": {
                      "propertyName": "type",
                      "mapping": {
                        "inference": "#/components/schemas/InferenceSessionDto",
                        "training": "#/components/schemas/TrainingSessionDto",
                        "evaluation": "#/components/schemas/EvaluationSessionDto"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a group of sessions of a single type",
        "tags": [
          "sessions"
        ],
        "x-query": true
      }
    },
    "/api/sessions/count": {
      "post": {
        "operationId": "countSessions",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionSearchValuesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Count sessions of any type",
        "tags": [
          "sessions"
        ],
        "x-query": true
      }
    },
    "/api/{type}/sessions/count": {
      "post": {
        "operationId": "countSessionsByType",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionType"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionSearchValuesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Count sessions of a single type",
        "tags": [
          "sessions"
        ],
        "x-query": true
      }
    },
    "/api/{type}/{sessionId}": {
      "get": {
        "operationId": "getSession",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionType"
            }
          },
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/InferenceSessionDto"
                    },
                    {
                      "$ref": "#/components/schemas/TrainingSessionDto"
                    },
                    {
                      "$ref": "#/components/schemas/EvaluationSessionDto"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "type",
                    "mapping": {
                      "inference": "#/components/schemas/InferenceSessionDto",
                      "training": "#/components/schemas/TrainingSessionDto",
                      "evaluation": "#/components/schemas/EvaluationSessionDto"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get a session",
        "tags": [
          "sessions"
        ]
      },
      "delete": {
        "operationId": "deleteSession",
        "parameters": [
          {
            "name": "type",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SessionType"
            }
          },
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "name": "should_delete",
            "required": true,
            "in": "query",
            "description": "The session is deleted only when true",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete a session",
        "tags": [
          "sessions"
        ]
      }
    }
