  "info": {
    "title": "API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "InferenceSessionType": {
        "type": "string",
        "enum": [
          "inference"
        ]
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "pending",
          "in_progress",
          "running",
          "completed",
          "failed",
          "canceled"
        ]
      },
      "RecommendationResultsDto": {
        "type": "object",
        "properties": {
          "variationa": {
            "type": "string",
            "nullable": true
          },
          "variationb": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "score"
            ]
          }
        },
        "required": [
          "variationa",
          "variationb",
          "type"
        ]
      },
      "RecommendationsDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "statistic": {
            "type": "string"
          },
          "results": {
            "$ref": "#/components/schemas/RecommendationResultsDto"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionStatus"
              }
            ]
          }
        },
        "required": [
          "session_id",
          "statistic",
          "results",
          "status"
        ]
      },
      "InferenceSessionDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InferenceSessionType"
              }
            ]
          },
          "session_owner": {
            "type": "string"
          },
          "image_a_url": {
            "type": "string"
          },
          "image_b_url": {
            "type": "string"
          },
          "creation_time": {
            "type": "string",
            "description": "Naive ISO-8601 timestamp in UTC (no timezone designator)",
            "example": "2026-11-09T12:00:00.000"
          },
          "last_update": {
            "type": "string",
            "description": "Naive ISO-8601 timestamp in UTC (no timezone designator)",
            "example": "2026-11-09T12:00:00.000"
          },
          "progress": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionStatus"
              }
            ]
          },
          "notes": {
            "type": "string"
          },
          "logs": {
            "type": "string",
            "nullable": true
          },
          "variationa_info": {
            "type": "object",
            "nullable": true
          },
          "variationb_info": {
            "type": "object",
            "nullable": true
          },
          "recommendations": {
            "$ref": "#/components/schemas/RecommendationsDto"
          },
          "statistics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "session_id",
          "type",
          "session_owner",
          "image_a_url",
          "image_b_url",
          "creation_time",
          "last_update",
          "progress",
          "status",
          "notes",
          "logs",
          "variationa_info",
          "variationb_info",
          "recommendations",
          "statistics"
        ]
      },
      "TrainingSessionType": {
        "type": "string",
        "enum": [
          "training"
        ]
      },
      "TrainingSessionDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrainingSessionType"
              }
            ]
          },
          "session_owner": {
            "type": "string"
          },
          "image_a_url": {
            "type": "string"
          },
          "image_b_url": {
            "type": "string"
          },
          "creation_time": {
            "type": "string",
            "description": "Naive ISO-8601 timestamp in UTC (no timezone designator)",
            "example": "2026-11-09T12:00:00.000"
          },
          "last_update": {
            "type": "string",
            "description": "Naive ISO-8601 timestamp in UTC (no timezone designator)",
            "example": "2026-11-09T12:00:00.000"
          },
          "progress": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionStatus"
              }
            ]
          },
          "notes": {
            "type": "string"
          },
          "logs": {
            "type": "string",
            "nullable": true
          },
          "variationa_info": {
            "type": "object",
            "nullable": true
          },
          "variationb_info": {
            "type": "object",
            "nullable": true
          },
          "training_type": {
            "type": "string",
            "nullable": true
          },
          "s8_link": {
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "type",
          "session_owner",
          "image_a_url",
          "image_b_url",
          "creation_time",
          "last_update",
          "progress",
          "status",
          "notes",
          "logs",
          "variationa_info",
          "variationb_info",
          "training_type",
          "s8_link"
        ]
      },
      "EvaluationSessionType": {
        "type": "string",
        "enum": [
          "evaluation"
        ]
      },
      "EvaluationSessionDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EvaluationSessionType"
              }
            ]
          },
          "session_owner": {
            "type": "string"
          },
          "image_a_url": {
            "type": "string"
          },
          "image_b_url": {
            "type": "string"
          },
          "creation_time": {
            "type": "string",
            "description": "Naive ISO-8601 timestamp in UTC (no timezone designator)",
            "example": "2026-11-09T12:00:00.000"
          },
          "last_update": {
            "type": "string",
            "description": "Naive ISO-8601 timestamp in UTC (no timezone designator)",
            "example": "2026-11-09T12:00:00.000"
          },
          "progress": {
            "type": "number",
            "nullable": true,
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionStatus"
              }
            ]
          },
          "notes": {
            "type": "string"
          },
          "logs": {
            "type": "string",
            "nullable": true
          },
          "variationa_info": {
            "type": "object",
            "nullable": true
          },
          "variationb_info": {
            "type": "object",
            "nullable": true
          },
          "evaluated_image_url": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "session_id",
          "type",
          "session_owner",
          "image_a_url",
          "image_b_url",
          "creation_time",
          "last_update",
          "progress",
          "status",
          "notes",
          "logs",
          "variationa_info",
          "variationb_info",
          "evaluated_image_url"
        ]
      },
      "SessionSearchValuesDto": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Case-insensitive text to look for in the session id",
            "maxLength": 200
          },
          "session_owner": {
            "type": "string",
            "description": "Case-insensitive text to look for in the session owner",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "description": "Case-insensitive text to look for in the session status",
            "maxLength": 200
          }
        }
      },
      "GroupSessionsBodyDto": {
        "type": "object",
        "properties": {
          "search_values": {
            "description": "Sessions must match every provided value",
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionSearchValuesDto"
              }
            ]
          }
        }
      },
      "SessionType": {
        "type": "string",
        "enum": [
          "training",
          "inference",
          "evaluation"
        ]
      }
    }
  }
}
